<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Activity on Your Post</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .header {
            background-color: #f9f9f9;
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid #eeeeee;
        }

        .logo {
            max-height: 40px;
        }

        .content {
            padding: 40px 30px;
            text-align: center;
            color: #333333;
        }

        h1 {
            font-size: 24px;
            margin-bottom: 20px;
            color: #1a1a1a;
        }

        p {
            font-size: 16px;
            line-height: 1.6;
            color: #666666;
            margin-bottom: 20px;
        }

        .actor-name {
            font-weight: 600;
            color: #1a1a1a;
        }

        .comment-preview {
            background-color: #f9f9f9;
            border-left: 3px solid #0095f6;
            padding: 12px 16px;
            margin: 20px 0;
            text-align: left;
            color: #333333;
            font-style: italic;
        }

        .post-preview {
            margin: 20px 0;
        }

        .post-preview img {
            max-width: 200px;
            border-radius: 8px;
            border: 1px solid #eeeeee;
        }

        .btn {
            display: inline-block;
            padding: 14px 30px;
            background-color: #0095f6;
            color: #ffffff;
            text-decoration: none;
            border-radius: 4px;
            font-weight: 600;
            font-size: 16px;
            transition: background-color 0.2s;
        }

        .btn:hover {
            background-color: #0074cc;
        }

        .footer {
            padding: 20px;
            background-color: #f9f9f9;
            text-align: center;
            font-size: 12px;
            color: #999999;
            border-top: 1px solid #eeeeee;
        }

        .link-fallback {
            margin-top: 30px;
            font-size: 14px;
            color: #999999;
            word-break: break-all;
        }

        .link-fallback a {
            color: #0095f6;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <img src="https://raw.githubusercontent.com/SilentSarah/Camagru/refs/heads/main/src/frontend/public/CG.svg" alt="Camagru Logo" class="logo">
        </div>
        <div class="content">
            <h1>%s</h1>
            <p><span class="actor-name">%s</span> %s</p>
            %s
            <a href="%s" class="btn">
                <span style="color: #ffffff !important;">
                    View Post
                </span>
            </a>

            <div class="link-fallback">
                <p>If the button doesn't work, copy and paste this link into your browser:</p>
                <a href="%s">%s</a>
            </div>
        </div>
        <div class="footer">
            <p>&copy; Camagru. All rights reserved.</p>
            <p>You received this email because you have notifications enabled. You can disable them in your account settings.</p>
        </div>
    </div>
</body>

</html>
